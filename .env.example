# ------------------------------------------------------------------------------
EMAILJS_SERVICE_ID=service_1tnij0f
EMAILJS_TEMPLATE_ID=template_pnixwxg
EMAILJS_PUBLIC_KEY=HsrT1U-D1Liv5ehyI
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_1tnij0f
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_pnixwxg
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=HsrT1U-D1Liv5ehyI
