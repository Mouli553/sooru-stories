# ==============================================================================
# Sooru & Stories - Production Environment Configuration Reference
# Copy this file to .env.local for local development. Never commit .env.local.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Site Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="Sooru & Stories"
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Razorpay Publishable Key (Safe for browser SDK initialization)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# ------------------------------------------------------------------------------
# 2. Database & Backend (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SERVER-ONLY SECRET: Do NOT prefix with NEXT_PUBLIC_. Keep strictly on backend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. Payment Gateway (Razorpay India)
# ------------------------------------------------------------------------------
# Razorpay Key ID and Secret used by server endpoints to create orders & issue refunds
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere

# Razorpay Webhook Secret configured in your Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# ------------------------------------------------------------------------------
